# Router image: FRRouting (maintained successor of Quagga), Alpine-based so busybox is included.
# FRR's core daemon is zebra; we add the BGP, OSPF and IS-IS daemons.
FROM quay.io/frrouting/frr:10.7.1

# Enable the routing daemons the subject requires (zebra always runs).
RUN sed -i -e 's/^bgpd=.*/bgpd=yes/' -e 's/^ospfd=.*/ospfd=yes/' -e 's/^isisd=.*/isisd=yes/' /etc/frr/daemons

# Fail the build if the three daemons are not enabled.
RUN [ "$(grep -cE '^(bgpd|ospfd|isisd)=yes' /etc/frr/daemons)" -eq 3 ]

# One shared config file for all daemons, edited and saved through vtysh.
RUN echo "service integrated-vtysh-config" > /etc/frr/vtysh.conf && touch /etc/frr/frr.conf && chown frr:frr /etc/frr/vtysh.conf /etc/frr/frr.conf

# Entrypoint inherited from the base image (tini -> docker-start) starts the daemons.
# No IP address is configured by default.
