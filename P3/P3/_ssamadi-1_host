#!/bin/sh
# =====================================================================
# host-ssamadi-1 — P3, behind routeur-ssamadi-2 (VTEP 1.1.1.2)
# Usage: paste into the host's main console.
# =====================================================================
# eth1 = the interface cabled to routeur-ssamadi-2 (GNS3 link e1, MAC ...:01).
# Its MAC is announced by EVPN (type 2) as soon as the host starts, BEFORE any IP.
# Overlay address: same subnet as host-2 and host-3 (20.1.1.0/24) -> one LAN through
# VXLAN VNI 10. No gateway needed: every host sees the others as local (ARP + frames).
ip addr add 20.1.1.1/24 dev eth1

# Test: ping -c 3 20.1.1.3   (ttl=64: the inner packet is never routed)
